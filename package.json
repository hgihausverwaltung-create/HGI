{
  "name": "hgi-protokoll",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:migrate": "pnpm --filter @hgi/api exec prisma migrate dev",
    "db:generate": "pnpm --filter @hgi/api exec prisma generate",
    "db:seed": "pnpm --filter @hgi/api exec prisma db seed"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.7.0"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma"
    ],
    "packageExtensions": {
      "@react-pdf/renderer": {
        "dependencies": {
          "@types/react": "18.3.31"
        }
      },
      "react-router-dom": {
        "dependencies": {
          "@types/react": "18.3.31"
        }
      },
      "react-router": {
        "dependencies": {
          "@types/react": "18.3.31"
        }
      }
    }
  }
}
